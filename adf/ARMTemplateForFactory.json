{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "adf-road-safety-dev-mm-01015"
        },
        "ls_adls_roadsafety_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://stroadsafetydevmm0105.dfs.core.windows.net/"
        },
        "ls_http_tps_ksi_source_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://stg-arcgisazurecdataprod.az.arcgis.com/exportfiles-6104-19483/"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "[concat(parameters('factoryName'), '/ls_adls_roadsafety')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "description": "Connection to ADLS Gen2 roadsafety data lake using managed identity",
                "annotations": [],
                "type": "AzureBlobFS",
                "typeProperties": {
                    "url": "[parameters('ls_adls_roadsafety_properties_typeProperties_url')]"
                }
            },
            "dependsOn": []
        },
        {
            "name": "[concat(parameters('factoryName'), '/ls_http_tps_ksi_source')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "description": "HTTP connection to Toronto Police Service public KSI collision dataset source",
                "annotations": [],
                "type": "HttpServer",
                "typeProperties": {
                    "url": "[parameters('ls_http_tps_ksi_source_properties_typeProperties_url')]",
                    "enableServerCertificateValidation": true,
                    "authenticationType": "Anonymous"
                }
            },
            "dependsOn": []
        },
        {
            "name": "[concat(parameters('factoryName'), '/ds_http_ksi_collision_raw')]",
            "type": "Microsoft.DataFactory/factories/datasets",
            "apiVersion": "2018-06-01",
            "properties": {
                "linkedServiceName": {
                    "referenceName": "ls_http_tps_ksi_source",
                    "type": "LinkedServiceReference"
                },
                "parameters": {
                    "relative_url": {
                        "type": "string"
                    }
                },
                "annotations": [],
                "type": "Binary",
                "typeProperties": {
                    "location": {
                        "type": "HttpServerLocation",
                        "relativeUrl": {
                            "value": "@dataset().relative_url",
                            "type": "Expression"
                        }
                    }
                }
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/ls_http_tps_ksi_source')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/ds_adls_ksi_collision_raw')]",
            "type": "Microsoft.DataFactory/factories/datasets",
            "apiVersion": "2018-06-01",
            "properties": {
                "linkedServiceName": {
                    "referenceName": "ls_adls_roadsafety",
                    "type": "LinkedServiceReference"
                },
                "parameters": {
                    "file_name": {
                        "type": "string"
                    }
                },
                "annotations": [],
                "type": "Binary",
                "typeProperties": {
                    "location": {
                        "type": "AzureBlobFSLocation",
                        "fileName": {
                            "value": "@dataset().file_name",
                            "type": "Expression"
                        },
                        "folderPath": "raw/collisions",
                        "fileSystem": "roadsafety"
                    }
                }
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/ls_adls_roadsafety')]"
            ]
        },
        {
            "name": "[concat(parameters('factoryName'), '/pl_ingest_ksi_collision_raw')]",
            "type": "Microsoft.DataFactory/factories/pipelines",
            "apiVersion": "2018-06-01",
            "properties": {
                "activities": [
                    {
                        "name": "copy_ksi_collision_to_raw",
                        "type": "Copy",
                        "dependsOn": [],
                        "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "source": {
                                "type": "BinarySource",
                                "storeSettings": {
                                    "type": "HttpReadSettings",
                                    "requestMethod": "GET"
                                },
                                "formatSettings": {
                                    "type": "BinaryReadSettings"
                                }
                            },
                            "sink": {
                                "type": "BinarySink",
                                "storeSettings": {
                                    "type": "AzureBlobFSWriteSettings"
                                }
                            },
                            "enableStaging": false
                        },
                        "inputs": [
                            {
                                "referenceName": "ds_http_ksi_collision_raw",
                                "type": "DatasetReference",
                                "parameters": {
                                    "relative_url": "@pipeline().parameters.p_source_relative_url"
                                }
                            }
                        ],
                        "outputs": [
                            {
                                "referenceName": "ds_adls_ksi_collision_raw",
                                "type": "DatasetReference",
                                "parameters": {
                                    "file_name": "@pipeline().parameters.p_sink_file_name"
                                }
                            }
                        ]
                    }
                ],
                "policy": {
                    "elapsedTimeMetric": {}
                },
                "parameters": {
                    "p_source_relative_url": {
                        "type": "string",
                        "defaultValue": "TOTAL_KSI_3737821728629277523.csv?sv=2025-05-05&st=2026-05-02T01%3A50%3A13Z&se=2026-05-02T02%3A55%3A13Z&sr=c&sp=r&sig=g6fhiEudjzcBhejjeFEBKvK0aiYL5ztRPQ446Uo4l4Q%3D"
                    },
                    "p_sink_file_name": {
                        "type": "string",
                        "defaultValue": "ksi_collisions_2006_2023_raw.csv"
                    }
                },
                "annotations": []
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/datasets/ds_http_ksi_collision_raw')]",
                "[concat(variables('factoryId'), '/datasets/ds_adls_ksi_collision_raw')]"
            ]
        }
    ]
}